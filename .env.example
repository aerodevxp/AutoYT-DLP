# ===========================================================================
# auto_ytdlp configuration
# Copy to .env and adjust. .env is gitignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Netscape-format cookies.txt. Optional — leave blank to run without cookies.
COOKIES_FILE=/path/to/cookies.txt

# Playlist list file: one entry per line, format:
#   comment;url;videoORaudio;downloaddir
# Blank lines and lines starting with '#' are ignored. Inline ' # ...' comments
# are stripped. 'kind' defaults to video; 'downloaddir' defaults to the comment.
PLAYLIST_FILE=./playlists.txt

# ---------------------------------------------------------------------------
# Output templates (relative to each entry's download dir)
# ---------------------------------------------------------------------------
VIDEO_TEMPLATE=%(playlist_index)03d - %(title)s [%(id)s].%(ext)s
AUDIO_TEMPLATE=%(playlist_index)03d - %(title)s [%(id)s].%(ext)s

# ---------------------------------------------------------------------------
# Format selection
# ---------------------------------------------------------------------------
# Video: best up to 1440p, preferring efficient codecs (AV1 > VP9).
# Use 'b[ext=mp4]/b' for a pre-muxed file (no merge, no ffmpeg).
FORMAT_SELECTOR=bv[height<=1440][vcodec^=av01]+ba[acodec^=opus]/bv[height<=1440][vcodec^=vp9]+ba[acodec^=opus]/bv[height<=1440]+ba/b[height<=1440]/b
# Container for merged video. mkv = remux only (no re-encode).
MERGE_FORMAT=mkv

# Audio: native m4a preferred, so files stay in an audio container.
AUDIO_FORMAT=bestaudio[ext=m4a]/bestaudio
# Convert audio to AUDIO_CODEC (needed to guarantee no .webm output).
AUDIO_CONVERT=true
AUDIO_CODEC=m4a
AUDIO_QUALITY=192

# ---------------------------------------------------------------------------
# Post-processing (ffmpeg-based). Off = fewer passes = faster.
# ---------------------------------------------------------------------------
EMBED_THUMBNAIL=false
EMBED_METADATA=false

# ---------------------------------------------------------------------------
# JS runtime + EJS solver (required for YouTube n-sig challenges)
# ---------------------------------------------------------------------------
# Install the runtime locally so nothing lands in $HOME:
#   curl -fsSL https://deno.land/install.sh | DENO_INSTALL="$PWD/.deno" sh
JS_RUNTIME_DIR=./.deno/bin
# Solver script distribution. ejs:github is recommended.
REMOTE_COMPONENTS=ejs:github
# Local yt-dlp cache (holds the downloaded solver).
CACHE_DIR=./.cache/yt-dlp
# TLS impersonation target (needs: pip install -U "yt-dlp[curl-cffi]").
# Helps with sites that fingerprint browsers (e.g. PornHub). Blank = auto.
IMPERSONATE=chrome

# ---------------------------------------------------------------------------
# Rate limiting / politeness
# ---------------------------------------------------------------------------
# Seconds between videos (randomised between SLEEP_INTERVAL and MAX_SLEEP_INTERVAL).
SLEEP_INTERVAL=3
MAX_SLEEP_INTERVAL=10
# Seconds between individual HTTP requests. Raise if you get 429s.
SLEEP_INTERVAL_REQUESTS=1
# Concurrent fragment downloads. 1 = gentlest.
CONCURRENT_FRAGMENTS=1

# ---------------------------------------------------------------------------
# Dedupe (folder-independent, content-hash based)
# ---------------------------------------------------------------------------
DEDUPE=true
# On a content duplicate: 'existing' deletes the new copy, 'new' replaces the old.
DEDUPE_KEEP=existing
GLOBAL_ARCHIVE=./.global_archive.txt
LIBRARY_FILE=./.dedupe_library.json

# ---------------------------------------------------------------------------
# Scan (seeds the library + ID archive from existing files)
# ---------------------------------------------------------------------------
# Roots to index. Semicolon-separated. With --scan and no DIR args, these are
# used plus every downloaddir from the playlist file.
SCAN_ROOTS=
# Excluded from scanning: bare folder names (glob ok) or paths. Semicolon-sep.
SCAN_EXCLUDE=.archives;.git;.cache
# Media extensions to index.
SCAN_EXTS=mp4,mkv,webm,mp3,m4a,opus,flac,wav,ogg,aac
# Only fingerprint files not already in the library (fast routine scans).
SCAN_NEW_ONLY=false
# Files between durable progress lines.
SCAN_LOG_EVERY=200
# Prune dead library entries + scan for new files before every run
SYNC_ON_RUN=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_FILE=./auto_ytdlp.log
# Seconds between download progress lines.
LOG_PROGRESS_INTERVAL=30
# Seconds of silence before a heartbeat line.
HEARTBEAT_INTERVAL=60

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Verbose yt-dlp output (incl. HTTP status codes).
VERBOSE=false
# Optional yt-dlp extractor args, e.g. youtube:player_client=default,web_safari
EXTRACTOR_ARGS=
# Purge stale .part/.ytdl leftovers before each download.
CLEAN_PART_FILES=true
